# Defaults for `npm run dev`. To reach a backend elsewhere, do not edit this file --
# put VITE_BACKEND_URL in .env.development.local, which is ignored by git and wins
# over this one. Only VITE_BACKEND_URL is read here, and only by the dev server proxy.
VITE_BACKEND_ENDPOINT = "/api"
VITE_BACKEND_URL = "http://localhost:4000"
VITE_PROJECT_NAME = "MIGRATOR"
VITE_LANGUAGE = "en"
