# Defaults baked into `npm run build`. The image build overrides these from the
# Dockerfile, and real env vars win over this file. VITE_BACKEND_URL is absent on
# purpose: the built app reaches the API through nginx, not through the dev proxy.
VITE_BACKEND_ENDPOINT = "/api"
VITE_PROJECT_NAME = "MIGRATOR"
VITE_LANGUAGE = "en"
